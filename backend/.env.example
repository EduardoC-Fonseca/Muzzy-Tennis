# Copie para .env e ajuste. O .env não é versionado.

APP_NAME="Muzzi Tennis API"
ENVIRONMENT=development   # development | test | production
DEBUG=true

# Banco de dados (MySQL). Com o docker compose, use DB_HOST=localhost a partir da máquina
# e DB_HOST=db de dentro do container da API.
DB_HOST=localhost
DB_PORT=3306
DB_USER=muzzi
DB_PASSWORD=muzzi
DB_NAME=muzzi_tennis
# Alternativa: defina DATABASE_URL completa (tem prioridade sobre as variáveis DB_*).
# DATABASE_URL=mysql+pymysql://muzzi:muzzi@localhost:3306/muzzi_tennis?charset=utf8mb4

# Usado apenas pelo container do MySQL no docker compose.
MYSQL_ROOT_PASSWORD=root

# Autenticação (JWT). Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-inseguro-troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens liberadas no CORS (Flutter web em desenvolvimento), separadas por vírgula.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Regras de negócio (Documento de Visão)
RESERVA_PRAZO_PAGAMENTO_MINUTOS=60
CANCELAMENTO_ANTECEDENCIA_HORAS=24
ESTORNO_PERCENTUAL_DENTRO_PRAZO=100
DURACAO_SLOT_MINUTOS=60
LIMITE_RESERVAS_DIA_CLIENTE=2

# Upload de fotos das quadras
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
